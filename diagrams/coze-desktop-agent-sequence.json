  "cards": [
    {
      "dot": "emerald",
      "title": "关键事实",
      "items": [
        "renderer 从不直连本地 bridge，它只与云端通信",
        "bridge 只做协议翻译：frontier JSON-RPC ⟷ ACP，不做推理",
        "真正的 agent loop 在本地进程里，它甚至不知道 Coze 的存在"
      ]
    },
    {
      "dot": "cyan",
      "title": "三种协议",
      "items": [
        "前端 → 云端：HTTPS + JSON（/api/coze_claw/message/chat）",
        "云端 ↔ bridge：JSON-RPC 2.0 over WebSocket（frontier）",
        "bridge ↔ 本地 agent：ACP over stdio，NDJSON 一行一帧"
      ]
    },
    {
      "dot": "amber",
      "title": "折叠掉的两个角色",
      "items": [
        "用户：输入发生在客户端输入框，结果也渲染在同一侧",
        "本地配置与工作区：config.yaml / .env 决定模型与凭证，AGENTS.md 即系统提示词",
        "二者都在本机，不构成独立一跳，故未单列参与者"
      ]
    },
    {
      "dot": "rose",
      "title": "排查锚点",
      "items": [
        "日志里没有 session/prompt：消息没下到设备（deviceId 变了）",
        "只有一帧约 367 字节的 update：模型调用失败，去看 request_dump",
        "70004 get claw failed：本地目录只是孤儿，云端已不认"
      ]
    }
  ]
