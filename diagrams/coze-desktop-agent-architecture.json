  "cards": [
    {
      "dot": "emerald",
      "title": "三条通道",
      "items": [
        "客户端 → 云端：HTTPS，发消息与拉会话",
        "云端 ↔ bridge：WebSocket 上的 JSON-RPC 2.0",
        "bridge ↔ 本地 agent：stdio 上的 ACP"
      ]
    },
    {
      "dot": "cyan",
      "title": "端口一览",
      "items": [
        "coze-bridge 127.0.0.1:50337 — 本地 IPC，需 Bearer token",
        "coze-daemon 127.0.0.1:49951/rpc — 本地控制面",
        "cozedrive 127.0.0.1:49918 — 云盘服务"
      ]
    },
    {
      "dot": "amber",
      "title": "责任边界",
      "items": [
        "bridge 不做推理，只做协议翻译：frontier JSON-RPC ⟷ ACP",
        "只有本地 agent 进程知道模型与凭证的存在",
        "云端只负责身份、会话与路由，不执行本机命令"
      ]
    },
    {
      "dot": "rose",
      "title": "容易误判的地方",
      "items": [
        "renderer 从不直连 bridge，中间隔着云端",
        "bridge 是 WebSocket 客户端，不监听入站业务端口",
        "本地 agent 进程是懒加载：首次发消息才 spawn"
      ]
    }
  ]
